# PRODUCTION : Base URL of backend REST API (e.g. https://medistock-api.onrender.com/api)
# DEVELOPMENT : Leave empty or commented out to use Vite dev proxy (/api -> http://localhost:5000/api)
VITE_API_BASE_URL=

# Separate Vercel projects can use customer, pharmacy, or platform-admin.
# Leave empty for the combined local demo UI.
VITE_APP_MODE=
