generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model pharmacy_info {
  id         String    @id
  name       String
  is_open    Int       @default(1)
  updated_at DateTime? @default(now())
}

model medicines {
  id         String    @id
  name       String
  desc       String?
  price      Int
  stock      Int
  status     String    @default("Tersedia")
  created_at DateTime? @default(now())
}

model orders {
  id             String        @id
  customer_name  String
  phone          String
  address        String?       @default("-")
  delivery_type  String
  subtotal       Int
  service_fee    Int           @default(3000)
  total_amount   Int
  payment_status String        @default("Lunas (QRIS)")
  order_status   String        @default("Menunggu Konfirmasi")
  timestamp      String
  items          order_items[]
}

model order_items {
  id       Int    @id @default(autoincrement())
  order_id String
  name     String
  qty      Int
  price    Int
  order    orders @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}
