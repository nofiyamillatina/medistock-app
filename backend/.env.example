PORT=5000
HOST=0.0.0.0
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# REQUIRED: Generate a strong secret for production.
# Example (Linux/Mac): openssl rand -hex 32
# Example (Windows): node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_strong_random_secret_here

NODE_ENV=development

# PRODUCTION ONLY: Set this to your deployed frontend URL(s) to restrict CORS.
# Multiple origins can be comma-separated.
# Example: https://medistock.vercel.app, https://medistock.yourdomain.com
# Leave empty in development (localhost:3000 is allowed by default).
ALLOWED_ORIGIN=

# One-time platform admin bootstrap only; never commit real values.
# Confirmation must match PLATFORM_ADMIN_EMAIL exactly (case-insensitive).
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
PLATFORM_ADMIN_BOOTSTRAP_CONFIRM=
